{
  "name": "poseidon-frontend",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-frontend.js",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test --test-concurrency=1 --test-force-exit tests/*.test.mjs",
    "lint": "eslint src/app/api/spear src/lib/trident src/lib/services/packet/trident-hard-packet.ts src/components/spear --max-warnings=0",
    "start": "next start",
    "deploy": "bash ../poseidon-deploy.sh",
    "generate:code-catalogs": "node scripts/generate-code-catalogs.mjs",
    "spear:migrate-store": "node scripts/spear-migrate-store.mjs",
    "postinstall": "node scripts/copy-pdfjs-worker.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-textract": "^3.1075.0",
    "@napi-rs/canvas": "0.1.100",
    "@types/nodemailer": "^8.0.1",
    "lucide-react": "^1.14.0",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.1",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.20.6",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
