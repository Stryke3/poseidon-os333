ENVIRONMENT=production
NODE_ENV=production

# Global auth and internal access
NEXTAUTH_SECRET=
JWT_SECRET=
INTERNAL_API_KEY=
POSEIDON_API_KEY=

# Canonical service endpoints (no localhost in production)
POSEIDON_API_URL=
CORE_API_URL=
INTAKE_API_URL=
AVAILITY_SERVICE_URL=

# Database and cache
DATABASE_URL=
REDIS_URL=

# If URLs above are not provided, these become required:
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Storage
MINIO_SECRET_KEY=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_BUCKET=
MINIO_SECURE=true

# Public inquiry / business mailbox. Google fallback is disabled.
PUBLIC_INQUIRY_TO=patients@strykefox.com
PUBLIC_INQUIRY_ALLOWED_ORIGINS=
EMAIL_PROVIDER=zoho
EMAIL_INTAKE_USERNAME=patients@strykefox.com
EMAIL_INTAKE_MAILBOX=INBOX
ZOHO_REGION=com
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
ZOHO_OAUTH_REFRESH_TOKEN=
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_MAIL_FOLDER_ID=

# Mommy Care Kit Zoho Sheet projection.
# Dedicated Sheet credentials are optional when the shared Zoho OAuth grant
# contains both Mail and Sheet scopes.
ZOHO_SHEET_OAUTH_CLIENT_ID=
ZOHO_SHEET_OAUTH_CLIENT_SECRET=
ZOHO_SHEET_OAUTH_REFRESH_TOKEN=
MCK_ZOHO_SHEET_RESOURCE_ID=
MCK_ZOHO_PATIENT_DETAILS_SHEET=Patient Details
MCK_ZOHO_HEATHER_COVER_SHEET=Heather Cover
MCK_ZOHO_SHEET_HEADER_ROW=4

# Mommy Care Kit canonical organization and paid-posted notification worker.
MCK_ORG_ID=
MCK_PAID_NOTIFICATION_ENABLED=true
MCK_PAID_NOTIFICATION_POLL_SECONDS=60
MCK_PAID_NOTIFICATION_RECIPIENTS=ben@strykefox.com,heather@strykefox.com

# Dropbox intake archiving
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT_NAMESPACE_ID=
DROPBOX_INTAKE_PATH=

# Batch ingest from a laptop (Core not public): dashboard proxies /api/core/* → Core
# CORE_BASE_URL=https://dashboard.strykefox.com/api/core

# Integrations
AVAILITY_BASE_URL=
AVAILITY_CLIENT_ID=
AVAILITY_CLIENT_SECRET=
AVAILITY_TOKEN_URL=
STEDI_API_KEY=
